# Пароль закрытого раздела /learn/. В GitHub — секрет COURSE_PASSWORD.
COURSE_PASSWORD=change-me-00

# Видео уроков (этап 2). В GitHub — секрет LESSON_VIDEOS_JSON. Ключ — номер урока.
# provider: kinescope | vk | rutube | mp4 | none
#   kinescope: id = id видео из ссылки kinescope.io/<id>
#   vk:        id = "<oid>_<id>" или "<oid>_<id>_<hash>" (hash для приватных видео)
#   rutube:    id = "<id>" или "<id>?p=<ключ>" для приватных
#   mp4:       id = полный URL файла
LESSON_VIDEOS_JSON={"0":{"provider":"none","id":"","duration":0,"chapters":[]}}
