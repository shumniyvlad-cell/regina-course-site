---
import { Picture } from 'astro:assets';
import { Play, Clock } from '@lucide/astro';
import type { LessonVideo } from '../data/types';

interface Props {
  video: LessonVideo;
  poster: ImageMetadata;
  title: string;
  eager?: boolean;
}

const { video, poster, title, eager = false } = Astro.props;
const ready = video.provider !== 'none' && !!video.id;
---

<div class="vp" data-vp data-provider={video.provider} data-id={ready ? video.id : undefined}>
  <div class="vp__frame" data-vp-frame>
    <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1100px) 900px, 100vw"
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class="vp__poster"
    />
    {ready && (
      <button type="button" class="vp__play" data-vp-play aria-label={`Смотреть видео: ${title}`}>
          <span class="vp__play-ic">
            <Play size={30} stroke-width={2} aria-hidden="true" />
          </span>
        </button>
    )}
  </div>
  {!ready && (
    <div class="vp__soon">
          <span class="vp__soon-ic">
            <Clock size={20} stroke-width={2} aria-hidden="true" />
          </span>
          <p class="vp__soon-t">Видео скоро появится</p>
          <p class="vp__soon-d">Пока можно начать с&nbsp;задания и&nbsp;материалов ниже.</p>
        </div>
  )}
</div>

<script>
  type Provider = 'kinescope' | 'vk' | 'rutube' | 'mp4';

  const withParams = (base: string, params: Record<string, string>) => {
    const q = new URLSearchParams(params).toString();
    return base + (base.includes('?') ? '&' : '?') + q;
  };

  // Форматы встраивания: Kinescope — docs.kinescope.com (autoplay, t в секундах);
  // VK — video_ext.php?oid&id&hash из кода экспорта; Rutube — /play/embed/<id>[?p=<ключ>]
  function embedUrl(provider: Provider, id: string, t = 0): string {
    switch (provider) {
      case 'kinescope':
        return withParams(`https://kinescope.io/embed/${encodeURIComponent(id)}`, { autoplay: '1', ...(t ? { t: String(t) } : {}) });
      case 'vk': {
        const [, oid = '', vid = '', hash] = /^(-?\d+)_(\d+)(?:_(\w+))?$/.exec(id) ?? [];
        const params: Record<string, string> = { oid, id: vid, hd: '2', autoplay: '1' };
        if (hash) params.hash = hash;
        if (t) params.t = `${Math.floor(t / 60)}m${t % 60}s`;
        return withParams('https://vkvideo.ru/video_ext.php', params);
      }
      case 'rutube':
        return withParams(`https://rutube.ru/play/embed/${id}`, { autoplay: '1', ...(t ? { t: String(t) } : {}) });
      default:
        return id;
    }
  }

  function mount(root: HTMLElement, t = 0) {
    const provider = root.dataset.provider as Provider | 'none';
    const id = root.dataset.id;
    const frame = root.querySelector<HTMLElement>('[data-vp-frame]');
    if (!frame || !id || provider === 'none') return;

    if (provider === 'mp4') {
      let video = frame.querySelector('video');
      if (!video) {
        video = document.createElement('video');
        video.src = id;
        video.controls = true;
        video.playsInline = true;
        video.preload = 'metadata';
        frame.replaceChildren(video);
      }
      video.currentTime = t;
      void video.play().catch(() => {});
      video.focus();
      return;
    }

    const iframe = document.createElement('iframe');
    iframe.src = embedUrl(provider, id, t);
    iframe.title = 'Видео урока';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer; clipboard-write; screen-wake-lock';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.replaceChildren(iframe);
    root.classList.add('is-playing');
  }

  document.querySelectorAll<HTMLElement>('[data-vp]').forEach((root) => {
    root.querySelector('[data-vp-play]')?.addEventListener('click', () => mount(root));
    // главы: <button data-seek="120"> в пределах страницы
    document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((btn) =>
      btn.addEventListener('click', () => {
        mount(root, Number(btn.dataset.seek) || 0);
        root.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }),
    );
  });
</script>

<style>
  .vp {
    position: relative;
  }

  .vp__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: clamp(18px, 2.4vw, 30px);
    overflow: hidden;
    background: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .vp__frame :global(img),
  .vp__frame :global(iframe),
  .vp__frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .vp__frame :global(video) {
    object-fit: contain;
    background: #000;
  }

  .vp__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    background: rgba(47, 43, 39, 0.12);
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .vp__play:hover {
    background: rgba(47, 43, 39, 0.24);
  }

  .vp__play-ic {
    display: grid;
    place-items: center;
    width: clamp(64px, 9vw, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--rose);
    color: var(--ink);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s var(--ease);
  }

  .vp__play-ic :global(svg) {
    transform: translateX(2px);
    fill: currentColor;
  }

  .vp__play:hover .vp__play-ic {
    transform: scale(1.06);
  }

  .vp__soon {
    position: absolute;
    left: clamp(12px, 2vw, 24px);
    bottom: clamp(12px, 2vw, 24px);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: center;
    max-width: min(420px, calc(100% - 24px));
    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: rgba(244, 240, 234, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--ink);
  }

  .vp__soon-ic {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--rose);
  }

  .vp__soon-t {
    font-weight: 700;
    font-size: 15.5px;
  }

  .vp__soon-d {
    font-size: 13.5px;
    color: var(--muted);
  }

  @media (max-width: 559px) {
    .vp__soon {
      position: static;
      max-width: none;
      margin-top: 10px;
      background: var(--card);
      box-shadow: var(--shadow);
    }
  }
</style>
