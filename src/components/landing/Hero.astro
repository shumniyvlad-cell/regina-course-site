---
import { getImage } from 'astro:assets';
import { ArrowDown, Play } from '@lucide/astro';
import portrait from '../../assets/photos/01_portrait_white.jpg';
import portraitTall from '../../assets/photos/05_portrait_tie_portfolio.jpg';
import { config } from '../../config';

// Art direction: до 768 px — вертикальный портрет, шире — горизонтальный кадр из студии
const MOBILE = '(max-width: 767px)';
const mobileSizes = '88vw';
const desktopSizes = '(min-width: 960px) 38vw, 88vw';
const [mAvif, mWebp, dAvif, dWebp, fallback] = await Promise.all([
  getImage({ src: portraitTall, format: 'avif', widths: [360, 560, 820], sizes: mobileSizes }),
  getImage({ src: portraitTall, format: 'webp', widths: [360, 560, 820], sizes: mobileSizes }),
  getImage({ src: portrait, format: 'avif', widths: [420, 640, 820, 1080], sizes: desktopSizes }),
  getImage({ src: portrait, format: 'webp', widths: [420, 640, 820, 1080], sizes: desktopSizes }),
  getImage({ src: portrait, format: 'jpg', width: 820 }),
]);
---

<section class="hero" id="top">
  <div class="wrap hero__grid">
    <p class="eyebrow hero__eyebrow">Видеокурс · 16 уроков · 21 день</p>

    <h1 class="hero__title">
      <span class="hero__l1">Выйти из</span>
      <span class="hero__l2">
        черновиков
        <svg class="hero__scribble" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M6 26 C 90 12, 170 30, 250 20 S 420 8, 500 18 S 575 26, 594 14" pathLength="1"></path>
        </svg>
      </span>
    </h1>

    <p class="hero__lead">21 день от черновиков к живому блогу — с&nbsp;ИИ и&nbsp;без&nbsp;монтажёра.</p>

    <div class="hero__schema" role="img" aria-label="Черновики превращаются в 12 публикаций">
      <div class="sch sch--was">
        <div class="sch__drafts" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
        <span class="sch__label sch__label--was">черновики</span>
      </div>
      <span class="sch__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
      <div class="sch sch--now">
        <div class="sch__grid" aria-hidden="true">
          {Array.from({ length: 12 }, (_, i) => <i style={`--t:${i}`}></i>)}
        </div>
        <span class="sch__label">12 публикаций</span>
      </div>
    </div>

    <div class="hero__cta">
      <a class="btn" href={config.bot.main}>Начать курс</a>
      <a class="btn btn--ghost" href="#program">
        Смотреть программу
        <ArrowDown size={18} stroke-width={2} aria-hidden="true" />
      </a>
      {
        config.flags.showTrailer && config.trailer.provider !== 'none' && (
          <button class="btn btn--ghost" type="button" data-trailer-open>
            <Play size={18} stroke-width={2} aria-hidden="true" />
            Смотреть, как выглядит урок
          </button>
        )
      }
    </div>

    <ul class="hero__chips" aria-label="Формат курса">
      <li class="chip">16 уроков</li>
      <li class="chip">21 день</li>
      <li class="chip">6–12 минут</li>
    </ul>

    <p class="hero__note">
      Уроки — в&nbsp;личном кабинете на&nbsp;сайте, напоминания и&nbsp;задания — в&nbsp;Telegram-боте · доступ на&nbsp;12&nbsp;месяцев.
    </p>

    <div class="hero__media">
      <span class="hero__circle" aria-hidden="true"></span>
      <figure class="hero__photo" data-parallax>
        <picture>
          <source media={MOBILE} type="image/avif" srcset={mAvif.srcSet.attribute} sizes={mobileSizes} />
          <source media={MOBILE} type="image/webp" srcset={mWebp.srcSet.attribute} sizes={mobileSizes} />
          <source type="image/avif" srcset={dAvif.srcSet.attribute} sizes={desktopSizes} />
          <source type="image/webp" srcset={dWebp.srcSet.attribute} sizes={desktopSizes} />
          <img
            src={fallback.src}
            width={portrait.width}
            height={portrait.height}
            alt="Регина Репортёр — автор курса"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <figcaption class="pill">Регина Репортёр</figcaption>
      </figure>
      <p class="hero__badge">
        <span class="hero__badge-k">за&nbsp;21&nbsp;день</span>
        профиль, контент-план и&nbsp;12&nbsp;публикаций
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(20px, 4vw, 48px) clamp(64px, 8vw, 112px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'eyebrow'
      'title'
      'lead'
      'cta'
      'chips'
      'media'
      'schema'
      'note';
    align-items: start;
  }

  .hero__eyebrow {
    grid-area: eyebrow;
    margin-bottom: 18px;
  }

  .hero__title {
    grid-area: title;
    position: relative;
    z-index: 2;
    font-weight: 800;
    font-size: clamp(44px, 13.4vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }

  .hero__l1,
  .hero__l2 {
    display: block;
  }

  .hero__l2 {
    position: relative;
    width: max-content;
  }

  .hero__scribble {
    position: absolute;
    left: 0.02em;
    right: -0.02em;
    bottom: -0.16em;
    width: calc(100% + 0.02em);
    height: 0.28em;
    overflow: visible;
    z-index: -1;
  }

  .hero__scribble path {
    fill: none;
    stroke: var(--rose);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hero__lead {
    grid-area: lead;
    margin-top: clamp(22px, 3vw, 34px);
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.4;
    font-weight: 500;
    max-width: 30ch;
    text-wrap: pretty;
  }

  /* ---- схема «черновики → 12 публикаций» ---- */
  .hero__schema {
    grid-area: schema;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    max-width: 420px;
  }

  .sch {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 16px;
    border-radius: var(--r-md);
    background: var(--card);
    box-shadow: var(--shadow);
    min-height: 132px;
    align-content: space-between;
  }

  .sch--now {
    background: var(--ink);
    color: var(--on-dark);
  }

  .sch__label {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.25;
  }

  .sch__label--was {
    color: var(--muted);
    position: relative;
  }

  .sch__label--was::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 52%;
    height: 1.5px;
    background: var(--accent);
    transform-origin: left;
  }

  .sch__drafts {
    position: relative;
    width: 58px;
    height: 64px;
  }

  .sch__drafts i {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    border: 1.5px dashed #c9bdb0;
    background:
      linear-gradient(#e2d9ce, #e2d9ce) 10px 14px / 60% 3px no-repeat,
      linear-gradient(#e2d9ce, #e2d9ce) 10px 24px / 44% 3px no-repeat,
      linear-gradient(#e2d9ce, #e2d9ce) 10px 34px / 52% 3px no-repeat,
      #fbf9f5;
  }

  .sch__drafts i:nth-child(1) {
    transform: rotate(-9deg) translate(-4px, 2px);
  }

  .sch__drafts i:nth-child(2) {
    transform: rotate(6deg) translate(5px, -1px);
  }

  .sch__arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--rose);
    color: var(--ink);
  }

  .sch__arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sch__grid {
    display: grid;
    grid-template-columns: repeat(4, 14px);
    gap: 4px;
  }

  .sch__grid i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--rose);
  }

  .sch__grid i:nth-child(3n + 2) {
    background: #f4f0ea;
  }

  .sch__grid i:nth-child(4n + 3) {
    background: #b87c70;
  }

  /* ---- кнопки и чипы ---- */
  .hero__cta {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero__cta .btn {
    flex: 1 1 auto;
  }

  .hero__chips {
    grid-area: chips;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .hero__note {
    grid-area: note;
    margin-top: 22px;
    font-size: 14.5px;
    color: var(--muted);
    max-width: 52ch;
  }

  /* ---- фото ---- */
  .hero__media {
    grid-area: media;
    position: relative;
    margin-top: 44px;
    padding: 0 0 34px;
    max-width: 520px;
    width: 100%;
    justify-self: center;
  }

  .hero__circle {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    right: -14%;
    top: -9%;
    border-radius: 50%;
    background: var(--rose);
  }

  .hero__photo {
    position: relative;
    margin-inline: 6% 0;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 4 / 4.6;
    box-shadow: var(--shadow-lift);
    background: #ece5dc;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% 30%;
  }

  @media (max-width: 767px) {
    .hero__photo {
      aspect-ratio: 4 / 5;
    }

    /* вертикальный портрет: лицо в верхней трети */
    .hero__photo img {
      object-position: 50% 18%;
    }
  }

  .pill {
    position: absolute;
    left: 18px;
    top: 18px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(47, 43, 39, 0.5);
    color: #fff;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__badge {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 280px;
    padding: 16px 20px;
    border-radius: var(--r-md);
    background: var(--card);
    box-shadow: var(--shadow-lift);
    font-weight: 600;
    font-size: 15.5px;
    line-height: 1.35;
  }

  .hero__badge-k {
    display: block;
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  @media (min-width: 560px) {
    .hero__cta .btn {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      column-gap: clamp(32px, 4vw, 64px);
      grid-template-areas:
        'eyebrow media'
        'title   media'
        'lead    media'
        'schema  media'
        'cta     media'
        'chips   media'
        'note    media';
      grid-template-rows: auto auto auto auto auto auto 1fr;
    }

    .hero__title {
      font-size: clamp(84px, 8.1vw, 132px);
      white-space: nowrap;
    }

    .hero__schema {
      margin-top: 30px;
    }

    .hero__media {
      margin-top: 8px;
      max-width: none;
      align-self: start;
    }

    .hero__photo {
      aspect-ratio: 4 / 5;
    }
  }

  /* ---- движение: один оркестрованный момент при загрузке ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__scribble path {
      stroke-dashoffset: 1;
      animation: draw 1.1s 0.45s var(--ease) forwards;
    }

    .sch__label--was::after {
      transform: scaleX(0);
      animation: strike 0.5s 1s var(--ease) forwards;
    }

    .sch__grid i {
      opacity: 0.12;
      transform: scale(0.6);
      animation: tile 0.45s var(--ease) forwards;
      animation-delay: calc(1.2s + var(--t) * 70ms);
    }

    .hero__media {
      animation: rise 1s 0.15s var(--ease) both;
    }

    .hero__badge {
      animation: rise 0.8s 0.7s var(--ease) both;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes strike {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes tile {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
