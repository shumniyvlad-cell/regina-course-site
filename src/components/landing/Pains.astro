---
import { typo } from '../../utils/typo';
import { Check } from '@lucide/astro';
const thoughts = [
  'Идей много, а публикаций нет.',
  'Сначала подготовлюсь: свет, курс, красивая лента…',
  'А вдруг знакомые увидят и засмеют.',
  'Сняла ролик — и он третий месяц лежит в галерее.',
];
---

<section class="pains section" aria-labelledby="pains-h">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Знакомо</p>
      <h2 class="h2" id="pains-h">Блог стоит не&nbsp;из-за&nbsp;лени</h2>
    </div>

    <ul class="notes" data-notes>
      {
        thoughts.map((t, i) => (
          <li class="note" style={`--i:${i}`} data-reveal>
            <div class="note__bar">
              <span>Заметки</span>
              <span class="note__state">
                <span class="note__draft">черновик</span>
                <span class="note__done">
                  <Check size={13} stroke-width={2.6} aria-hidden="true" /> опубликовано
                </span>
              </span>
            </div>
            <p class="note__text">
              <span>«{typo(t)}»</span>
            </p>
          </li>
        ))
      }
    </ul>

    <p class="pains__thought" data-reveal>
      Это страх, который прячется за&nbsp;«нет времени» и&nbsp;«не&nbsp;о&nbsp;чем писать». Курс начинается именно с&nbsp;него — а&nbsp;потом шаг за&nbsp;шагом доводит до&nbsp;публикаций.
    </p>
  </div>
</section>

<style>
  .pains {
    background: var(--rose);
    overflow: hidden;
  }

  .pains .eyebrow {
    color: var(--ink);
  }

  .notes {
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr);
  }

  .note {
    background: var(--card);
    border-radius: var(--r-md);
    padding: 16px 20px 22px;
    box-shadow: 0 18px 40px rgba(47, 43, 39, 0.1);
    transform: rotate(var(--rot, 0deg));
  }

  .note:nth-child(1) {
    --rot: -1.6deg;
  }
  .note:nth-child(2) {
    --rot: 1.2deg;
  }
  .note:nth-child(3) {
    --rot: -0.8deg;
  }
  .note:nth-child(4) {
    --rot: 1.8deg;
  }

  .js .note[data-reveal].is-in {
    transform: rotate(var(--rot));
  }

  .note__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--quiet);
  }

  .note__state {
    display: grid;
  }

  .note__draft,
  .note__done {
    grid-area: 1 / 1;
    justify-self: end;
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .note__done {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--rose);
    opacity: 0;
    transform: translateY(6px);
  }

  .note__text {
    font-size: clamp(19px, 1.9vw, 22px);
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note__text span {
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 58% / 0% 2px;
    transition:
      background-size 0.9s var(--ease),
      color 0.6s;
  }

  /* зачёркиваем мысль и «публикуем» — когда карточка видна */
  .note.is-done .note__text span {
    background-size: 100% 2px;
    color: var(--muted);
  }

  .note.is-done .note__draft {
    opacity: 0;
    transform: translateY(-6px);
  }

  .note.is-done .note__done {
    opacity: 1;
    transform: none;
    transition-delay: 0.6s;
  }

  .pains__thought {
    margin-top: clamp(40px, 6vw, 72px);
    max-width: 30ch;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  @media (min-width: 720px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 26px;
    }
  }

  @media (min-width: 1100px) {
    .notes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .note:nth-child(even) {
      margin-top: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note__text span,
    .note__draft,
    .note__done {
      transition: none;
    }
  }
</style>
